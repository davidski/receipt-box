# Build-time setting: public path where the static Nuxt app is mounted.
# It must start and end with a slash, for example /pricebook/.
NUXT_APP_BASE_URL=/

# Build-time setting: API root used by the browser. It may be a path or a full URL.
# If omitted, it defaults to NUXT_APP_BASE_URL followed by api.
# Examples: /api, /pricebook/api, https://api.example.com/pricebook/api
NUXT_PUBLIC_API_BASE=/api

# Runtime server setting: PostgreSQL connection used only by Nitro.
DATABASE_URL=postgres://pricebook:change-me@postgres.example.com:5432/pricebook?sslmode=require

# Optional full Unix socket filename. When set, the server uses this instead of
# the hostname and port in DATABASE_URL.
# DATABASE_SOCKET_PATH=/var/run/postgresql/.s.PGSQL.5432

# Local test-stack host ports. Production traffic reaches the container through
# the external Traefik network instead of published ports.
APP_PORT=3000
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myResolver
EXT_HOSTNAME=pricebook.example.com
